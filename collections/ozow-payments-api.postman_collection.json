                  "key": "Optional4",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "Optional5",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "Customer",
                  "value": "<string>",
                  "description": "Optional customer name/identifier."
                },
                {
                  "disabled": false,
                  "key": "CancelUrl",
                  "value": "<uri>"
                },
                {
                  "disabled": false,
                  "key": "ErrorUrl",
                  "value": "<uri>"
                },
                {
                  "disabled": false,
                  "key": "SuccessUrl",
                  "value": "<uri>"
                },
                {
                  "disabled": false,
                  "key": "NotifyUrl",
